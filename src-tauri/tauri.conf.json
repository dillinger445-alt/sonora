{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SONORA",
  "version": "0.4.2",
  "identifier": "app.sonora.analyzer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SONORA",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#1b1e21",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "media-src": "'self' blob: sonora: http://sonora.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREOUIyQ0RFMzY4NTRCQzIKUldUQ1M0VTIzaXliVGVLTytlUTdpWFozSmJEVjFHK0daa0laRERNaVRLQWJaRCs4a1JDb2NjYi8K",
      "endpoints": [
        "https://github.com/dillinger445-alt/sonora/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "category": "Music",
    "publisher": "SONORA",
    "copyright": "© 2026 SONORA contributors",
    "shortDescription": "Professional audio quality analyzer",
    "longDescription": "SONORA analyses music files locally and scores their technical quality, DJ suitability and listening suitability, with explainable findings about clipping, loudness, lossy sources and more.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
