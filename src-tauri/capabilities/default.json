{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the SONORA main window: core defaults, window dragging for the overlay title bar, native open/save dialogs, Reveal in Finder/Explorer, opening Discogs pages, SONORA's release notes and guides, slskd's project page and its web page on this computer in the browser, and checking for, installing and restarting into updates.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://www.discogs.com/*"
        },
        {
          "url": "https://github.com/dillinger445-alt/sonora/releases*"
        },
        {
          "url": "https://github.com/dillinger445-alt/sonora/blob/main/docs/*"
        },
        {
          "url": "https://github.com/slskd/slskd*"
        },
        {
          "url": "http://127.0.0.1:5030*"
        },
        {
          "url": "http://localhost:5030*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
