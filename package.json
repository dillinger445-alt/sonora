{
  "name": "sonora",
  "private": true,
  "version": "0.1.0",
  "description": "SONORA — professional audio quality analyzer for DJs and listeners",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "node scripts/dev-web.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "npm run test:unit && npm run test:rust",
    "test:unit": "node --test \"src/**/*.test.ts\"",
    "test:rust": "cargo test --workspace",
    "test:e2e": "playwright test",
    "fixtures": "cargo run --release -p sonora-cli -- fixtures fixtures/library",
    "bridge": "cargo run --release -p sonora-devserver -- --static dist",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg.mjs",
    "tauri": "tauri",
    "app:dev": "node scripts/fetch-ffmpeg.mjs --if-missing --optional && tauri dev",
    "app:build": "node scripts/fetch-ffmpeg.mjs && tauri build --config src-tauri/tauri.bundle-ffmpeg.json"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-opener": "~2.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.0",
    "@tauri-apps/cli": "~2.12.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~6.0.3",
    "vite": "^7.1.0"
  }
}
